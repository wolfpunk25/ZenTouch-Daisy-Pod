+
+void String::UpdateDampingCoefficients()
+{
+    coeffs_dirty_ = false;
+
+    float brightness = brightness_;
+    float damping_cutoff
+        = fmin(12.0f + damping_ * damping_ * 60.0f + brightness * 24.0f, 84.0f);
+
+    cached_damp_pow_ = powf(2.f, damping_cutoff * kOneTwelfth);
+
+    // Crossfade to infinite decay.
+    cached_to_infinite_ = 0.0f;
+    if(damping_ >= 0.95f)
+    {
+        cached_to_infinite_ = 20.0f * (damping_ - 0.95f);
+        brightness += cached_to_infinite_ * (1.0f - brightness);
+        damping_cutoff += cached_to_infinite_ * (128.0f - damping_cutoff);
+    }
+    cached_brightness_ = brightness;
+
+    const float ratio         = powf(2.f, damping_cutoff * kOneTwelfth);
+    cached_damp_compensation_ = 1.f - 2.f * atanf(1.f / ratio) / (TWOPI_F);
 }
 
